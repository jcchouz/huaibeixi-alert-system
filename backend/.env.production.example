ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api
SERVICE_VERSION=3.0.0

DB_HOST=timescaledb.example.internal
DB_PORT=5432
DB_NAME=huaibeixi_db
DB_USER=huaibeixi
DB_PASSWORD=replace-with-secret-manager-value
DB_CONNECT_TIMEOUT=10
DB_POOL_MINCONN=2
DB_POOL_MAXCONN=20

CORS_ORIGINS=https://monitor.example.com
TRUSTED_HOSTS=monitor.example.com,backend
# Required for SSE fan-out when running more than one backend worker/container.
REDIS_URL=redis://redis:6379/0
REDIS_CHANNEL=huaibeixi:alerts:events

AUTH_ENABLED=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=huaibeixi-alert-backend
JWT_AUDIENCE=huaibeixi-alert-frontend
JWT_EXPIRE_MINUTES=480
# Generate with:
# python tools/hash_password.py "your-password" --username admin --role admin
AUTH_USERS_JSON=[]

LOG_LEVEL=INFO
LOG_JSON=true

REPLAY_WORKER_ENABLED=true
REPLAY_LEADER_LOCK_ENABLED=true
REPLAY_LEADER_LOCK_KEY=809090028
REPLAY_START_WATERMARK=2026-09-28 13:55:00
REPLAY_FALLBACK_END=2026-09-30 17:55:20
DEMO_ENDPOINTS_ENABLED=false
