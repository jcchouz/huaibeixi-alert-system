ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
SERVICE_VERSION=3.0.0

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=huaibeixi_db
DB_USER=huaibeixi
DB_PASSWORD=replace-me
DB_CONNECT_TIMEOUT=10
DB_POOL_MINCONN=2
DB_POOL_MAXCONN=20

DETECTION_ENABLED=true
DETECTION_INTERVAL_SECONDS=5
DETECTION_LAG_SECONDS=5
DETECTION_WINDOW_MINUTES=1
DETECTION_CONFIRM_POINTS=3
DETECTION_STUCK_POINTS=100
DETECTION_OFFLINE_POINTS=5
DETECTION_MAX_CATCHUP_WINDOWS=5

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=INFO
LOG_JSON=true
