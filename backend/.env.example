# ============================================================
# 后端运行时配置示例（由 app/core/config.py 加载，变量名不区分大小写）
# 使用方式：复制为 backend/.env 后按实际环境填写；真实 .env 不入库。
# 修改后需重启后端进程才会生效。
# ============================================================

# ---------- 应用与 API ----------
# 运行环境：development / test / staging / production
# production 下会拒绝 CORS_ORIGINS 中包含 * 的配置
ENVIRONMENT=development
# 调试模式开关，true 时会输出更详细的错误信息
DEBUG=false
# 所有 REST 接口的统一前缀
API_PREFIX=/api
# 服务版本号，用于接口返回和健康检查
SERVICE_VERSION=3.0.0
# 当前站点名称；后端通过 t_station.name 解析站点编码并只加载该站点元数据
STATION_NAME=玉环站

# ---------- PostgreSQL 连接 ----------
# 数据库地址、端口、库名和账号
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=huaibeixi_db
DB_USER=huaibeixi
# 数据库密码，请填写实际值，切勿提交真实密码
DB_PASSWORD=change-me
# 建立连接的超时时间，单位秒
DB_CONNECT_TIMEOUT=10
# 连接池最小/最大连接数
DB_POOL_MINCONN=2
DB_POOL_MAXCONN=20

# ---------- 预警检测 ----------
# Realtime scan interval and optional late-commit lookback.
# The current ingestion contract delivers samples in timestamp order.
DETECTION_INTERVAL_SECONDS=1
DETECTION_ALERT_OVERLAP_SECONDS=0

# 阈值超限 / 超物理量程需连续命中的持续时间，单位秒
DETECTION_CONFIRM_SECONDS=3
# 传感器读数连续保持不变的持续时间，超过后判定为死值，单位秒
DETECTION_STUCK_SECONDS=100
# 通道连续无新采样点的持续时间，超过后判定为离线，单位秒
DETECTION_OFFLINE_SECONDS=5
# 阈值规则版本检查周期，单位秒
DETECTION_RULE_REFRESH_SECONDS=5

# ---------- 预警类型开关 ----------
# 关闭某一类预警只停止写入该类预警记录，采样和统计不受影响
# 阈值超限预警
DETECTION_ALERT_THRESHOLD_ENABLED=true
# 通道离线预警
DETECTION_ALERT_OFFLINE_ENABLED=true
# 采集仪离线预警
DETECTION_ALERT_DAQ_OFFLINE_ENABLED=true
# 传感器死值预警
DETECTION_ALERT_STUCK_ENABLED=true
# 超物理量程预警
DETECTION_ALERT_OOR_ENABLED=true

# ---------- HTTP 安全 ----------
# 允许跨域访问的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# 允许访问的主机名，* 表示不限制
TRUSTED_HOSTS=*

# ---------- 日志 ----------
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# true 输出 JSON 格式日志，false 输出普通文本日志
LOG_JSON=false
