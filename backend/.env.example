ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
SERVICE_VERSION=3.0.0

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=huaibeixi_db
DB_USER=huaibeixi
DB_PASSWORD=replace-me
DB_CONNECT_TIMEOUT=10
DB_POOL_MINCONN=2
DB_POOL_MAXCONN=20

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1

# Development can disable authentication. Production startup refuses to run without it.
AUTH_ENABLED=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=huaibeixi-alert-backend
JWT_AUDIENCE=huaibeixi-alert-frontend
JWT_EXPIRE_MINUTES=480
AUTH_USERS_JSON=[]

LOG_LEVEL=INFO
LOG_JSON=true
