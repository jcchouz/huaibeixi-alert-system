{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端：调试 (8090)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8090"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "注入器：单通道阈值样本",
      "type": "debugpy",
      "request": "launch",
      "module": "tools.inject_threshold",
      "args": ["--level", "3", "--seconds", "20"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "单元测试：阈值连续命中",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_realtime_detection.py", "-k", "threshold", "-s"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
